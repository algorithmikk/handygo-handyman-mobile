{
  "expo": {
    "name": "HandyGo Technician",
    "slug": "handygo-handyman-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "handygo-handyman",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.handygo.technician",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HandyGo needs your location to show nearby jobs and provide navigation to job sites.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HandyGo uses your location in the background to update your availability and match you with nearby jobs.",
        "NSCameraUsageDescription": "HandyGo needs camera access to take photos of completed work.",
        "NSPhotoLibraryUsageDescription": "HandyGo needs photo library access to upload job completion photos."
      }
    },
    "android": {
      "package": "com.handygo.technician",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "HandyGo uses your location to match you with nearby maintenance jobs and provide navigation."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#10b981"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "HandyGo needs access to your photos to upload job completion images.",
          "cameraPermission": "HandyGo needs camera access to take photos of completed work."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://handygo.vercel.app/backend/api/v1",
      "router": {},
      "eas": {
        "projectId": "c197aaa3-719b-416c-8183-04b226706df5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c197aaa3-719b-416c-8183-04b226706df5"
    },
    "owner": "jaw_ari"
  }
}
